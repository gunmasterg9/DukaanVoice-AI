# DukaanVoice AI — frontend environment
# Copy to .env if you need to override the API base URL.
# Do not commit .env files.

# Leave unset to use the Vite dev proxy:
#   /api -> http://127.0.0.1:8000
# To call the API directly (requires CORS on the backend):
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
