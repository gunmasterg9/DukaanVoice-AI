# DukaanVoice AI — backend environment
# Copy to .env in this directory and adjust if needed.
# Do not commit .env.

# Bind address. Keep 127.0.0.1 so the API is not exposed on the LAN.
DUKAANVOICE_HOST=127.0.0.1
DUKAANVOICE_PORT=8000

# Application data directory (created if missing). Database lives here.
# Default: <backend>/data
# DUKAANVOICE_DATA_DIR=C:\Users\RAHUL\Desktop\gautam\DukaanVoice AI\backend\data

# SQLite database file. Must not be a temp dir or a frontend build dir.
# Default: <data dir>\dukaanvoice.db
# DUKAANVOICE_DATABASE_PATH=C:\Users\RAHUL\Desktop\gautam\DukaanVoice AI\backend\data\dukaanvoice.db

# Timestamped SQLite backups. Default: <backend>\backups
# DUKAANVOICE_BACKUP_DIR=C:\Users\RAHUL\Desktop\gautam\DukaanVoice AI\backend\backups

# Comma-separated CORS origins for the Vite dev server.
DUKAANVOICE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
